{
  "name": "@nextcloud/moment",
  "version": "1.3.5",
  "description": "Customized moment.js for Nextcloud",
  "keywords": [
    "nextcloud",
    "moment"
  ],
  "homepage": "https://github.com/nextcloud-libraries/nextcloud-moment#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/nextcloud-libraries/nextcloud-moment"
  },
  "license": "GPL-3.0-or-later",
  "author": "Christoph Wurst",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  },
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "scripts": {
    "build": "vite --mode production build",
    "build:doc": "typedoc --out dist/doc lib/index.ts && touch dist/doc/.nojekyll",
    "dev": "vite --mode development build",
    "l10n:extract": "node build/extract-l10n.js",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "ts:check": "tsc --noEmit"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@nextcloud/l10n": "^3.4.0",
    "moment": "^2.31.0"
  },
  "devDependencies": {
    "@nextcloud/browserslist-config": "^3.0.1",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/vite-config": "^2.5.4",
    "@types/node": "^24.0.3",
    "eslint": "^10.12.0",
    "gettext-extractor": "^4.0.1",
    "gettext-parser": "^9.1.1",
    "jsdom": "^26.1.0",
    "typedoc": "^0.28.7",
    "typescript": "^5.8.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || ^24.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.3.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": "^24.0.0"
    }
  }
}
